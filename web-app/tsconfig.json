{
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./backend-build",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": true
  },
  "include": ["../testudo-module/**/*", "./server/**/*.ts"],
  "exclude": [
    "../build",
    "../dist",
    "build",
    "./database.types.ts",
    "./client/**/**.ts"
  ]
}
